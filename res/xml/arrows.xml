<?xml version="1.0" encoding="utf-8"?>
<!-- Traditional direct-tap arrow cluster opened from the main keyboard. -->
<keyboard bottom_row="false">
  <row height="1.05">
    <key shift="1.3" width="1.3" role="action" key0="up"/>
  </row>
  <row height="1.05">
    <key width="1.3" role="action" key0="left"/>
    <key width="1.3" role="action" key0="down"/>
    <key width="1.3" role="action" key0="right"/>
  </row>
  <row height="0.95">
    <key role="action" key0="switch_text"/>
    <key width="3" role="space_bar" key0="space"/>
    <key role="action" key0="backspace" key2="delete"/>
    <key role="action" key0="enter" key2="action"/>
  </row>
</keyboard>
